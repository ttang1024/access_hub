{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "cardholder-sites": {
        "ClusterId": "cardholder",
        "Order": 100,
        "Match": {
          "Path": "/api/v1/sites/{**rest}"
        }
      },
      "cardholder-cardholders": {
        "ClusterId": "cardholder",
        "Match": {
          "Path": "/api/v1/cardholders/{**rest}"
        }
      },
      "cardholder-cards": {
        "ClusterId": "cardholder",
        "Match": {
          "Path": "/api/v1/cards/{**rest}"
        }
      },
      "cardholder-access-groups": {
        "ClusterId": "cardholder",
        "Match": {
          "Path": "/api/v1/access-groups/{**rest}"
        }
      },
      "access-control-sync-status": {
        "ClusterId": "access-control",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/sites/sync-status"
        }
      },
      "access-control-access": {
        "ClusterId": "access-control",
        "Match": {
          "Path": "/api/v1/access/{**rest}"
        }
      },
      "access-control-grpc": {
        "ClusterId": "access-control-grpc",
        "TimeoutPolicy": "Disable",
        "Match": {
          "Path": "/accesshub.sync.v1.AccessListSync/{**method}"
        },
        "RateLimiterPolicy": "site"
      },
      "ingestion-events": {
        "ClusterId": "event-ingestion",
        "Order": 1,
        "RateLimiterPolicy": "site",
        "Match": {
          "Path": "/api/v1/sites/{siteId}/events"
        }
      },
      "alarm-alarms": {
        "ClusterId": "alarm",
        "Match": {
          "Path": "/api/v1/alarms/{**rest}"
        }
      },
      "alarm-hub": {
        "ClusterId": "alarm",
        "TimeoutPolicy": "Disable",
        "Match": {
          "Path": "/hubs/{**rest}"
        }
      }
    },
    "Clusters": {
      "cardholder": {
        "Destinations": {
          "primary": {
            "Address": "http://cardholder-api"
          }
        }
      },
      "access-control": {
        "Destinations": {
          "primary": {
            "Address": "http://access-control-api"
          }
        }
      },
      "access-control-grpc": {
        "Destinations": {
          "primary": {
            "Address": "http://_grpc.access-control-api"
          }
        },
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionExact",
          "ActivityTimeout": "00:02:00"
        }
      },
      "event-ingestion": {
        "Destinations": {
          "primary": {
            "Address": "http://event-ingestion-api"
          }
        }
      },
      "alarm": {
        "Destinations": {
          "primary": {
            "Address": "http://alarm-api"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "Site": {
      "PermitsPerSecond": 20,
      "Burst": 60
    }
  }
}
